{
  "name": "deutsch-easier",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file=.env src/server/index.ts",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --external:drizzle-orm --external:@google/genai --external:dotenv --external:@neondatabase/serverless",
    "build:api": "esbuild src/server/vercel.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/index.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --external:@google/genai --external:dotenv --external:@neondatabase/serverless",
    "build": "npm run build:client && npm run build:server && npm run build:api",
    "postbuild": "node scripts/check-api-bundle.mjs",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "tts:smoke": "tsx scripts/check-tts-voices.ts"
  },
  "dependencies": {
    "@google/genai": "^0.2.0",
    "@hono/node-server": "^1.13.8",
    "@neondatabase/serverless": "^0.10.4",
    "@sefinek/google-tts-api": "^2.1.15",
    "@soundtouchjs/formant-correction-worklet": "^2.1.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.39.3",
    "effect": "^3.13.0",
    "hono": "^4.7.2",
    "lucide-react": "^0.475.0",
    "nanoid": "^5.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.1",
    "node-edge-tts": "^1.2.12",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.3"
  }
}
