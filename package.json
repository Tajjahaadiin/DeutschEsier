{
  "name": "deutsch-easier",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file=.env src/server/index.ts",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.js --external:drizzle-orm --external:@google/genai --external:dotenv --external:msedge-tts --external:@neondatabase/serverless",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^0.2.0",
    "@hono/node-server": "^1.13.8",
    "@neondatabase/serverless": "^0.10.4",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.39.3",
    "effect": "^3.13.0",
    "hono": "^4.7.2",
    "lucide-react": "^0.475.0",
    "msedge-tts": "^2.0.7",
    "nanoid": "^5.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
