# Google Gemini API Key dari Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Pilihan Model Gemini (Free Tier default: gemini-3.6-flash)
# Opsi model yang didukung di Google AI Studio:
# - gemini-3.6-flash (Default & direkomendasikan, 10-15 RPM, 1.500 RPD)
# - gemini-3.5-flash (Alternatif stabil)
# - gemini-3.5-flash-lite (Hemat latensi)
GEMINI_MODEL=gemini-3.6-flash

# Konfigurasi Database (PostgreSQL / Neon)
# Contoh: postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""
# Port Server
PORT=3001

# Wajib: password/PIN login guru. Dipakai juga sebagai secret HMAC untuk token sesi.
# Jika dikosongkan, server memakai fallback tidak aman 'guru123' — JANGAN di production.
TEACHER_PASSWORD=""
# Alias lama yang masih didukung (dipakai bila TEACHER_PASSWORD kosong).
# TEACHER_SECRET_KEY=""
