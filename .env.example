# Google Gemini API Key dari Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Pilihan Model Gemini (Free Tier default: gemini-3.6-flash)
# Opsi model yang didukung di Google AI Studio:
# - gemini-3.6-flash (Default & direkomendasikan, 10-15 RPM, 1.500 RPD)
# - gemini-3.5-flash (Alternatif stabil)
# - gemini-3.5-flash-lite (Hemat latensi)
GEMINI_MODEL=gemini-3.6-flash

# Konfigurasi Database SQLite
# DATABASE_URL=./sqlite.db
DATABASE_URL=""
# Port Server
PORT=3001

# Opsional: Secret key untuk otorisasi guru (POST/DELETE sessions)
# TEACHER_SECRET_KEY=your_secret_key_here
